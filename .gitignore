# Node modules
node_modules/
*/node_modules/

# Environment variables and local secrets.
# The !.env.example negation must stay after the ignore rules so templates remain tracked.
.env
.env.*
!.env.example
**/.env.bak*
**/.env.backup*
.env.local
.env.*.local

# OAuth client downloads and private keys
client_secret_*.json
*.pem
*.p12
*.key
id_rsa
id_rsa.*

# Build outputs
dist/
build/
*/dist/
*/build/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Test coverage
coverage/
*/coverage/
.nyc_output/

# Prisma
*.db
*.db-journal
# SQLite WAL sidecars: belong to one specific database file and corrupt it if
# restored next to a different one (e.g. .hive-mind/hive.db)
*.db-wal
*.db-shm

# Playwright
test-results/
playwright-report/
playwright/.cache/

# Qdrant storage (local development)
qdrant_storage/

# Project CodeNet dataset (large files)
backend/data/codenet/metadata/*.csv
backend/data/codenet/javascript/**/*.js
backend/data/codenet/typescript/**/*.ts
backend/data/codenet/python/**/*.py
backend/data/codenet/preprocessed/**/*.json

# Keep directory structure
!backend/data/codenet/.gitkeep
!backend/data/codenet/*/.gitkeep

# Temporary files
*.tmp
*.temp
.cache/

# Memory bank session states (swarm coordination)
coordination/memory_bank/sessions/*.json
coordination/subtasks/*.md

# Plan files (auto-generated)
*.plan.md
